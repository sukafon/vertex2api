# API 访问密钥，支持用逗号分隔多个值。可省略；省略时首次启动会生成并持久化随机密钥。
# 如需固定密钥，请将下面的占位符替换为至少 16 个字符的随机字符串。
API_KEY=replace-with-a-random-secret

# 自动生成的 API_KEY 持久化文件路径（可选，默认 .vertex2api-api-key）
# API_KEY_FILE=.vertex2api-api-key

# 日志和自动任务使用的时区；可按需改为其他 IANA 时区
TZ=Asia/Shanghai

# 仅用于明确允许无鉴权的本地开发环境；生产环境不要开启
ALLOW_UNAUTHENTICATED=false

# 是否允许调用不在当前模型目录中的自定义模型名称；默认关闭
# 即使开启，自定义模型名仍禁止路径分隔符和 .. 序列
ALLOW_CUSTOM_MODEL_NAMES=false

# 统计接口密钥（可选）
# 留空时 /v1/stats 接口不可用
STATS_KEY=

# 服务监听地址，例如 0.0.0.0 或 127.0.0.1
HOST=0.0.0.0

# 服务端口
PORT=8080

# Vertex AI API 地址
VERTEX_BASE_URL=https://cloudconsole-pa.clients6.google.com

# GraphQL 浏览器链路使用的公开 API 标识
GRAPHQL_API_KEY=AIzaSyCI-zsRP85UVOi0DjtiCwWBwQ1djDy741g

# Vertex AI 前缀地址，用于配置反向代理，支持用逗号分隔多个值（可选）
PREFIX_VERTEX_BASE_URL=

# reCAPTCHA 服务地址
RECAPTCHA_BASE_URL=https://www.recaptcha.net

# reCAPTCHA 浏览器链路使用的公开站点密钥
RECAPTCHA_KEY=6LdCjtspAAAAAMcV4TGdWLJqRTEk1TfpdLqEnKdj

# reCAPTCHA 前缀地址，用于配置反向代理，支持用逗号分隔多个值（可选）
PREFIX_RECAPTCHA_BASE_URL=

# HTTP 代理（可选）
PROXY=

# 每个 Token 最大重试次数
MAX_RETRY=5

# 最大刷新 Token 次数
MAX_REFRESH=5

# 重试间隔（毫秒）
RETRY_DELAY_MS=1000

# 上游 HTTP 请求超时时间（秒）
HTTP_TIMEOUT_SECONDS=120

# 客户端响应写入超时时间（秒）
WRITE_TIMEOUT_SECONDS=600

# 是否开启自动拉取上游模型（可选，true/false；默认 true）
# 开启后，程序启动时自动拉取，并按 AUTO_FETCH_CRON 表达式定时拉取
AUTO_FETCH_MODELS=true

# 自动拉取模型的 Cron 表达式（可选，默认 "0 0,4 * * *" 表示每天 00:00 和 04:00 各拉取一次）
AUTO_FETCH_CRON=0 0,4 * * *

# 是否在日志中隐藏上游错误/响应详情；默认 false，便于诊断
REDACT_UPSTREAM_LOGS=false

# 浏览器跨域来源。默认留空即不发送 CORS 许可；可填具体 Origin，谨慎使用 *
CORS_ALLOW_ORIGIN=
